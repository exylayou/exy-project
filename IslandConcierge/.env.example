# Island Concierge - Environment Variables
# Copy this file to .env.local and fill in your API keys

# ====================
# GEMINI AI (Required for Chat functionality)
# ====================
# Get your API key from: https://ai.google.dev/
# 1. Go to Google AI Studio: https://makersuite.google.com/app/apikey
# 2. Click "Get API key" or "Create API key"
# 3. Copy the key and paste below
GEMINI_API_KEY=your_gemini_api_key_here

# ====================
# GOOGLE PLACES API (Required for POI/Explore functionality)
# ====================
# Get your API key from: https://console.cloud.google.com/
# 1. Go to Google Cloud Console
# 2. Create a new project or select existing
# 3. Enable "Places API" and "Maps JavaScript API"
# 4. Go to "Credentials" → "Create Credentials" → "API Key"
# 5. Copy the key and paste below
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ====================
# OPTIONAL: Development Settings
# ====================
# Set to 'development' for detailed error messages
NODE_ENV=production

# API Base URL (leave empty to use Netlify Functions auto-detection)
# API_BASE_URL=https://your-site.netlify.app/.netlify/functions
